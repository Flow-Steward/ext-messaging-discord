      "/applications/{application_id}/application-identities/{provider_type}/{provider_issued_user_id}": {
        "get": {
          "operationId": "list_application_identities_by_external_id",
          "description": "Look up identities by provider and external user ID. An unmatched key returns an empty list. The application bot must authenticate and the target user must grant application_identities.write.",
          "parameters": [
            {
              "in": "path",
              "name": "application_id",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1,
