                            },
                            "highest_rank": {
                              "type": "string",
                              "maxLength": 100
                            },
                            "featured_played_character": {
                              "type": "string",
                              "maxLength": 100
                            },
                            "rank_image": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
                              ],
                              "additionalProperties": false
                            },
                            "highest_rank_image": {
                              "type": "object",
                              "properties": {
                                "url": {
                                  "type": "string"
                                }
                              },
                              "required": [
                                "url"
