                            "total_wins": {
                              "type": "integer"
                            },
                            "total_games": {
                              "type": "integer"
                            },
                            "total_kills": {
                              "type": "integer"
                            },
                            "total_assists": {
                              "type": "integer"
                            },
                            "total_deaths": {
                              "type": "integer"
                            },
                            "current_period_wins": {
                              "type": "integer"
                            },
                            "current_period_games": {
                              "type": "integer"
                            },
                            "current_period_kills": {
                              "type": "integer"
                            },
                            "current_period_assists": {
                              "type": "integer"
                            },
                            "current_period_deaths": {
                              "type": "integer"
                            }
                          },
                          "required": [],
                          "additionalProperties": false
                        },
                        "dynamic": {
                          "type": "array",
                          "maxItems": 30,
                          "items": {
                            "oneOf": [
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "const": 1
                                  },
                                  "name": {
                                    "type": "string",
                                    "maxLength": 100
                                  },
                                  "value": {
                                    "type": "string",
                                    "maxLength": 100
                                  }
                                },
                                "required": [
                                  "type",
                                  "name",
                                  "value"
                                ],
                                "additionalProperties": false
                              },
                              {
                                "type": "object",
                                "properties": {
                                  "type": {
                                    "const": 2
                                  },
                                  "name": {
                                    "type": "string",
                                    "maxLength": 100
                                  },
                                  "value": {
                                    "type": "number"
                                  }
                                },
                                "required": [
                                  "type",
