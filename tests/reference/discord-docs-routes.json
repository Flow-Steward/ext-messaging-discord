              "schema": {
                "type": "string",
                "minLength": 1,
                "pattern": "^[0-9]+$"
              }
            },
            {
              "in": "path",
              "name": "provider_issued_user_id",
              "required": true,
              "schema": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "security": [
            {
              "BotToken": []
            }
          ],
          "responses": {
            "200": {}
          }
        },
        "patch": {
          "operationId": "update_application_identity_profile",
          "description": "Create or update a user's game stats profile. Supplying data replaces it entirely. Serialized data must fit within 10 KB. The application bot must authenticate and the target user must grant application_identities.write.",
